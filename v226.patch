 BASE = Path(__file__).parent
 PUBLIC = BASE / 'public'
 HOST_KEY = os.environ.get('HOST_KEY', 'blood-host')
+VAPID_SUBJECT = os.environ.get('VAPID_SUBJECT', 'mailto:urban-blood-rave@example.com')
+
+# Keep Web Push stable without requiring another secret in Render. A strong HOST_KEY
+# deterministically derives a P-256 VAPID key. VAPID_PRIVATE_KEY can override it.
+P256_ORDER = 0xFFFFFFFF00000000FFFFFFFFFFFFFFFFBCE6FAADA7179E84F3B9CAC2FC632551
+def _b64url(data: bytes) -> str:
+    return base64.urlsafe_b64encode(data).rstrip(b'=').decode('ascii')
+
+def _derive_vapid_private() -> str:
+    configured = os.environ.get('VAPID_PRIVATE_KEY')
+    if configured:
+        return configured.strip()
+    digest = hashlib.sha256(('urban-blood-rave-vapid:' + HOST_KEY).encode('utf-8')).digest()
+    scalar = (int.from_bytes(digest, 'big') % (P256_ORDER - 1)) + 1
+    return _b64url(scalar.to_bytes(32, 'big'))
+
+VAPID_PRIVATE_KEY = _derive_vapid_private()
+_vapid_scalar = int.from_bytes(base64.urlsafe_b64decode(VAPID_PRIVATE_KEY + '=' * (-len(VAPID_PRIVATE_KEY) % 4)), 'big')
+_vapid_key = ec.derive_private_key(_vapid_scalar, ec.SECP256R1())
+VAPID_PUBLIC_KEY = _b64url(_vapid_key.public_key().public_bytes(serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint))
+# pywebpush reliably accepts a PEM path. Generate it deterministically at startup
+# from HOST_KEY so deploys keep the same VAPID identity without another Render secret.
+VAPID_PEM_PATH = BASE / '.vapid-private.pem'
+VAPID_PEM_PATH.write_bytes(_vapid_key.private_bytes(
+    serialization.Encoding.PEM,
+    serialization.PrivateFormat.PKCS8,
+    serialization.NoEncryption(),
+))
 
